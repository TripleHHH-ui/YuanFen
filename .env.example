# Copy to .env and fill in. Never commit the real .env file.

# --- Atlas Sandbox (via the official atlas-flight-booking-skill CLI) ---
# Obtain via the CLI's own browser-based authorization flow (run it once locally),
# or via atlaslovestravel.com developer signup if the CLI asks for a pre-issued key.
# Confirm which path applies at the 19 Aug workshop.
ATLAS_ENV=sandbox

# --- Map tiles (MapLibre GL JS) ---
MAP_TILE_PROVIDER_URL=
MAP_TILE_PROVIDER_KEY=

# --- Places data ---
# Foursquare Open Source Places is offline/static (Apache 2.0) - no API key needed
# unless you also hit a live Foursquare endpoint for enrichment.
FOURSQUARE_API_KEY=

# --- Routing ---
# Set if using a hosted openrouteservice instance instead of self-hosted OSRM.
ORS_API_KEY=

# --- App ---
NODE_ENV=development
API_PORT=8787
